APP_NAME="IDEJ-SYS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://idej.example.mx
APP_TIMEZONE=America/Mexico_City
FORCE_HTTPS=true
TRUSTED_PROXIES=
PRODUCTION_REQUIRE_HTTPS=true
PRODUCTION_REQUIRE_REAL_MAILER=true
AUTH_TEMPORARY_PASSWORD_EXPIRE_HOURS=24

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=idej_sys
DB_USERNAME=idej_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@idej.example.mx"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

IDEJ_NOTIFICACIONES_POLLING_MS=5000
IDEJ_RECORDATORIOS_ADEUDO_ACTIVOS=false
IDEJ_RECORDATORIOS_EMAIL=false
IDEJ_RECORDATORIOS_DIAS_ANTES=3
IDEJ_RECORDATORIOS_DIAS_DESPUES=30
IDEJ_RECORDATORIOS_LIMITE_DIARIO=150
IDEJ_RECORDATORIOS_HORA=09:00
IDEJ_CARGOS_RECURRENTES_ACTIVOS=false
IDEJ_CARGOS_RECURRENTES_HORA=06:30

IDEMPOTENCY_CACHE_STORE=database
IDEMPOTENCY_LOCK_SECONDS=180
IDEMPOTENCY_TTL_SECONDS=900
