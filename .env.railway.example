APP_NAME="IDEJ-SYS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.up.railway.app
APP_TIMEZONE=America/Mexico_City
FORCE_HTTPS=true
TRUSTED_PROXIES=*
PRODUCTION_REQUIRE_HTTPS=true
PRODUCTION_REQUIRE_REAL_MAILER=true
AUTH_TEMPORARY_PASSWORD_EXPIRE_HOURS=24

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_URL=${{MySQL.MYSQL_URL}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=CONFIGURAR_SMTP
MAIL_PORT=587
MAIL_USERNAME=CONFIGURAR_USUARIO
MAIL_PASSWORD=CONFIGURAR_SECRETO_EN_RAILWAY
MAIL_FROM_ADDRESS="no-reply@idej.edu.mx"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

IDEJ_NOTIFICACIONES_POLLING_MS=5000
IDEJ_RECORDATORIOS_ADEUDO_ACTIVOS=false
IDEJ_RECORDATORIOS_EMAIL=false
IDEJ_RECORDATORIOS_DIAS_ANTES=3
IDEJ_RECORDATORIOS_DIAS_DESPUES=30
IDEJ_RECORDATORIOS_LIMITE_DIARIO=150
IDEJ_RECORDATORIOS_HORA=09:00
IDEJ_CARGOS_RECURRENTES_ACTIVOS=false
IDEJ_CARGOS_RECURRENTES_HORA=06:30

IDEMPOTENCY_CACHE_STORE=database
IDEMPOTENCY_LOCK_SECONDS=180
IDEMPOTENCY_TTL_SECONDS=900
